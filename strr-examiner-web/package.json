{
  "name": "strr-examiner-web",
  "private": true,
  "type": "module",
  "version": "0.2.60",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build-check": "nuxt build",
    "build": "nuxt generate",
    "dev": "nuxt dev --port 3000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preinstall": "node ensure-strr-base-web.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint --ext .ts,.vue app tests --ignore-path .gitignore",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest --dir tests/unit --passWithNoTests --coverage && cp ./tests/coverage/clover.xml ./coverage.xml",
    "test:unit": "vitest --dir tests/unit",
    "test:unit:cov": "vitest run --dir tests/unit --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:e2e:ui:all": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "3.21.0",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.57.0",
    "@testing-library/vue": "^8.1.0",
    "@types/lodash": "^4.17.21",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-tailwindcss": "^3.17.4",
    "happy-dom": "^20.0.11",
    "otplib": "^12.0.1",
    "playwright-core": "^1.57.0",
    "sass": "^1.77.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@daxiom/nuxt-core-layer-test": "^0.0.29",
    "country-codes-list": "^2.0.0",
    "nuxt": "3.15.4",
    "uuid": "^11.1.0",
    "v-calendar": "^3.1.2"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
