{
  "name": "strr-examiner-web",
  "private": true,
  "type": "module",
  "version": "0.2.58",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build-check": "nuxt build",
    "build": "nuxt generate",
    "dev": "nuxt dev --port 3000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --ext .ts,.vue app tests --ignore-path .gitignore",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest --dir tests/unit --passWithNoTests --coverage && cp ./tests/coverage/clover.xml ./coverage.xml",
    "test:unit": "vitest --dir tests/unit",
    "test:unit:cov": "vitest run --dir tests/unit --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:e2e:ui:all": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@nuxt/devtools": "3.4.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "4.1.0",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.57.0",
    "@testing-library/vue": "^8.1.0",
    "@types/lodash": "^4.17.21",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-tailwindcss": "^3.17.4",
    "happy-dom": "^20.0.11",
    "otplib": "^12.0.1",
    "playwright-core": "^1.57.0",
    "sass": "^1.77.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@daxiom/nuxt-core-layer-test": "^0.0.29",
    "country-codes-list": "^2.0.0",
    "nuxt": "4.5.2",
    "uuid": "^11.1.0",
    "v-calendar": "^3.1.2"
  },
  "packageManager": "pnpm@10.21.0+sha1.a2cb35d3f07a58fecfe050af9277c5dc43a1b2e7"
}
