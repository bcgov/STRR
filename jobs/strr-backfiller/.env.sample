DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Leave blank for host/port local debug; use only for local Unix socket testing
DATABASE_UNIX_SOCKET=

# Cloud SQL IAM (deployed GCP)
CLOUDSQL_INSTANCE_CONNECTION_NAME=
CLOUDSQL_IP_TYPE=PUBLIC

# Backfiller feature flags
BACKFILL_REGISTRATION_SEARCH=true
BACKFILL_REGISTRATION_SEARCH_BATCH_SIZE=100
BACKFILL_INTERACTION_RECIPIENTS=false
BACKFILL_INTERACTION_RECIPIENTS_BATCH_SIZE=1000

# Geocoder API
GEOCODER_API_URL=
GEOCODER_API_AUTH_KEY=
