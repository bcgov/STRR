{
  "name": "strr-host-pm-web",
  "private": true,
  "type": "module",
  "version": "1.3.39",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build-check": "nuxt build",
    "build": "nuxt generate",
    "dev": "nuxt dev --port 3000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --ext .ts,.vue app tests --ignore-path .gitignore",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "nuxi typecheck",
    "test": "vitest --dir tests/unit --coverage && cp ./tests/coverage/clover.xml ./coverage.xml",
    "test:unit": "vitest --dir tests/unit",
    "test:unit:bun": "bunx --bun vitest --dir tests/unit",
    "test:bun": "bunx --bun vitest --dir tests/unit",
    "test:unit:cov": "vitest run --dir tests/unit --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@faker-js/faker": "^10.6.0",
    "@nuxt/devtools": "4.2.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/test-utils": "4.4.0",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@pinia/testing": "^1.0.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/vue": "^8.1.0",
    "@types/lodash.uniqby": "^4.7.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^8.57.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "happy-dom": "^21.0.4",
    "otpauth": "^9.4.1",
    "playwright-core": "^1.55.0",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "vitest": "4.1.12",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@daxiom/nuxt-core-layer-test": "^0.0.29",
    "country-codes-list": "^2.0.0",
    "lodash.uniqby": "^4.7.0",
    "nuxt": "4.6.4",
    "uuid": "^11.1.1",
    "vue-country-flag-next": "^2.3.2"
  },
  "packageManager": "pnpm@11.9.0"
}
