{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://strr.gov.bc.ca/.well_known/schemas/registration_query",
  "type": "object",
  "title": "Registration Query Request",
  "additionalProperties": false,
  "properties": {
    "updatedSince": {
      "type": ["string", "null"]
    },
    "cursor": {
      "type": ["string", "null"]
    },
    "limit": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 500
    },
    "registrationNumbers": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 500
    }
  }
}
