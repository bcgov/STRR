{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://strr.gov.bc.ca/.well_known/schemas/registration_update",
  "type": "object",
  "title": "Registration Update",
  "description": "Schema for updating registration details. Supports partial updates to nested registration fields.",
  "definitions": {
    "contactEmail": {
      "type": "object",
      "properties": {
        "emailAddress": {
          "type": "string",
          "format": "email"
        }
      },
      "required": ["emailAddress"],
      "additionalProperties": false
    }
  },
  "properties": {
    "primaryContact": {
      "$ref": "#/definitions/contactEmail"
    },
    "secondaryContact": {
      "$ref": "#/definitions/contactEmail"
    },
    "propertyManager": {
      "type": "object",
      "properties": {
        "contact": {
          "$ref": "#/definitions/contactEmail"
        },
        "business": {
          "type": "object",
          "properties": {
            "primaryContact": {
              "$ref": "#/definitions/contactEmail"
            }
          },
          "required": ["primaryContact"],
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "minProperties": 1
}
